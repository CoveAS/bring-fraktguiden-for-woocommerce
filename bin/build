#!/usr/bin/env bash
#
# Build script for BFG templates
# Compiles .bfg.php files from src/templates/ to build/templates/
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_ROOT"

echo "🔨 Building BFG templates..."
echo ""

php bin/compile-templates.php

echo ""
echo "✅ Build complete!"
